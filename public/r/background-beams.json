"`linearGradient-${index}`\"\n            :key=\"`gradient-${index}`\"\n            gradientUnits=\"userSpaceOnUse\"\n            x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"0%\"\n        >\n          <stop :stop-color=\"colorFrom\" stop-opacity=\"0\" />\n          <stop :stop-color=\"colorFrom\" />\n          <stop offset=\"32.5%\" :stop-color=\"colorMid\" />\n          <stop offset=\"100%\" :stop-color=\"colorTo\" stop-opacity=\"0\" />\n\n          <animate\n              attributeName=\"x1\"\n              values=\"0%;100%\"\n              :dur=\"`${path.duration}s`\"\n              :begin=\"`${path.delay}s`\"\n              repeatCount=\"indefinite\"\n              calcMode=\"spline\"\n              keySplines=\"0.42 0 0.58 1\"\n          />\n          <animate\n              attributeName=\"x2\"\n              values=\"0%;95%\"\n              :dur=\"`${path.duration}s`\"\n              :begin=\"`${path.delay}s`\"\n              repeatCount=\"indefinite\"\n              calcMode=\"spline\"\n              keySplines=\"0.42 0 0.58 1\"\n          />\n          <animate\n              attributeName=\"y1\"\n              values=\"0%;100%\"\n              :dur=\"`${path.duration}s`\"\n              :begin=\"`${path.delay}s`\"\n              repeatCount=\"indefinite\"\n              calcMode=\"spline\"\n              keySplines=\"0.42 0 0.58 1\"\n          />\n          <animate\n              attributeName=\"y2\"\n              :values=\"`0%;${path.y2End}%`\"\n              :dur=\"`${path.duration}s`\"\n              :begin=\"`${path.delay}s`\"\n              repeatCount=\"indefinite\"\n              calcMode=\"spline\"\n              keySplines=\"0.42 0 0.58 1\"\n          />\n        </linearGradient>\n\n        <radialGradient\n            id=\"paint0_radial_242_278\"\n            cx=\"0\" cy=\"0\" r=\"1\"\n            gradientUnits=\"userSpaceOnUse\"\n            gradientTransform=\"translate(352 34) rotate(90) scale(555 1560.62)\"\n        >\n          <stop offset=\"0.06