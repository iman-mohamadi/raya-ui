      "path": "background-beams/BackgroundBeams.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport { cn } from '@/lib/utils'\n\ninterface Props {\n  class?: string\n  /** Starting color of the beam gradient */\n  colorFrom?: string\n  /** Middle color of the beam gradient */\n  colorMid?: string\n  /** Ending color of the beam gradient */\n  colorTo?: string\n  /** Base duration of the animation in seconds (randomness is added to this) */\n  duration?: number\n  /** Base delay of the animation in seconds */\n  delay?: number\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  colorFrom: '#18CCFC',\n  colorMid: '#6344F5',\n  colorTo: '#AE48FF',\n  duration: 10,\n  delay: 0\n})\n\nconst paths = [\n  \"M-380 -189C-380 -189 -312 216 152 343C616 470 684 875 684 875\",\n  \"M-373 -197C-373 -197 -305 208 159 335C623 462 691 867 691 867\",\n  \"M-366 -205C-366 -205 -298 200 166 327C630 454 698 859 698 859\",\n  \"M-359 -213C-359 -213 -291 192 173 319C637 446 705 851 705 851\",\n  \"M-352 -221C-352 -221 -284 184 180 311C644 438 712 843 712 843\",\n  \"M-345 -229C-345 -229 -277 176 187 303C651 430 719 835 719 835\",\n  \"M-338 -237C-338 -237 -270 168 194 295C658 422 726 827 726 827\",\n  \"M-331 -245C-331 -245 -263 160 201 287C665 414 733 819 733 819\",\n  \"M-324 -253C-324 -253 -256 152 208 279C672 406 740 811 740 811\",\n  \"M-317 -261C-317 -261 -249 144 215 271C679 398 747 803 747 803\",\n  \"M-310 -269C-310 -269 -242 136 222 263C686 390 754 795 754 795\",\n  \"M-303 -277C-303 -277 -235 128 229 255C693 382 761 787 761 787\",\n  \"M-296 -285C-296 -285 -228 120 236 247C700 374 768 779 768 779\",\n  \"M-289 -293C-289 -293 -221 112 243 239C707 366 775 771 775 771\",\n  \"M-282 -301C-282 -301 -214 104 250 231C714 358 782 763 782 763\",\n  \"M-275 -309C-275 -309 -207 96 257 223C721 350 789 755 789 755\",\n  \"M-268 -317C-268 -317 -200 88 264 215C728 342 796 747 796 747\",\n  \"M-261 -325C-261 -325 -193 80 271 207C735 334 803 739 803 739\",\n  \"M-254 -333C-254 -333 -186 72 278 199C742 326 810 731 810 731\",\n  \"M-247 -341C-247 -341 -179 64 285 191C749 318 817 723 817 723\",\n  \"M-240 -349C-240 -349 -172 56 292 183C756 310 824 715 824 715\",\n  \"M-233 -357C-233 -357 -165 48 299 175C763 302 831 707 831 707\",\n  \"M-226 -365C-226 -365 -158 40 306 167C770 294 838 699 838 699\",\n  \"M-219 -373C-219 -373 -151 32 313 159C777 286 845 691 845 691\",\n  \"M-212 -381C-212 -381 -144 24 320 151C784 278 852 683 852 683\",\n  \"M-205 -389C-205 -389 -137 16 327 143C791 270 859 675 859 675\",\n  \"M-198 -397C-198 -397 -130 8 334 135C798 262 866 667 866 667\",\n  \"M-191 -405C-191 -405 -123 0 341 127C805 254 873 659 873 659\",\n  \"M-184 -413C-184 -413 -116 -8 348 119C812 246 880 651 880 651\",\n  \"M-177 -421C-177 -421 -109 -16 355 111C819 238 887 643 887 643\",\n  \"M-170 -429C-170 -429 -102 -24 362 103C826 230 894 635 894 635\",\n  \"M-163 -437C-163 -437 -95 -32 369 95C833 222 901 627 901 627\",\n  \"M-156 -445C-156 -445 -88 -40 376 87C840 214 908 619 908 619\",\n  \"M-149 -453C-149 -453 -81 -48 383 79C847 206 915 611 915 611\",\n  \"M-142 -461C-142 -461 -74 -56 390 71C854 198 922 603 922 603\",\n  \"M-135 -469C-135 -469 -67 -64 397 63C861 190 929 595 929 595\",\n  \"M-128 -477C-128 -477 -60 -72 404 55C868 182 936 587 936 587\",\n  \"M-121 -485C-121 -485 -53 -80 411 47C875 174 943 579 943 579\",\n  \"M-114 -493C-114 -493 -46 -88 418 39C882 166 950 571 950 571\",\n  \"M-107 -501C-107 -501 -39 -96 425 31C889 158 957 563 957 563\",\n  \"M-100 -509C-100 -509 -32 -104 432 23C896 150 964 555 964 555\",\n  \"M-93 -517C-93 -517 -25 -112 439 15C903 142 971 547 971 547\",\n  \"M-86 -525C-86 -525 -18 -120 446 7C910 134 978 539 978 539\",\n  \"M-79 -533C-79 -533 -11 -128 453 -1C917 126 985 531 985 531\",\n  \"M-72 -541C-72 -541 -4 -136 460 -9C924 118 992 523 992 523\",\n  \"M-65 -549C-65 -549 3 -144 467 -17C931 110 999 515 999 515\",\n  \"M-58 -557C-58 -557 10 -152 474 -25C938 102 1006 507 1006 507\",\n  \"M-51 -565C-51 -565 17 -160 481 -33C945 94 1013 499 1013 499\"