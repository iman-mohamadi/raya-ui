{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "marquee",
  "type": "registry:ui",
  "title": "Marquee",
  "description": "Scrolling marquee text component",
  "dependencies": [
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "marquee/Marquee.vue",
      "content": "<script setup lang=\"ts\">\nimport { cn } from '@/lib/utils'\n\ninterface Props {\n  class?: string\n  reverse?: boolean\n  pauseOnHover?: boolean\n  vertical?: boolean\n  repeat?: number\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  reverse: false,\n  pauseOnHover: false,\n  vertical: false,\n  repeat: 4,\n  class: ''\n})\n</script>\n\n<template>\n  <div\n      :class=\"cn(\n      'group flex overflow-hidden p-2 [--duration:40s] [--gap:1rem] gap-(--gap)',\n      {\n        'flex-row': !vertical,\n        'flex-col': vertical,\n      },\n      props.class\n    )\"\n  >\n    <div\n        v-for=\"i in repeat\"\n        :key=\"i\"\n        :class=\"cn('flex shrink-0 justify-around gap-(--gap)', {\n        'animate-marquee flex-row': !vertical,\n        'animate-marquee-vertical flex-col': vertical,\n        'group-hover:paused': pauseOnHover,\n        'direction-[reverse]': reverse,\n      })\"\n    >\n      <slot />\n    </div>\n  </div>\n</template>",
      "type": "registry:ui"
    },
    {
      "path": "marquee/index.ts",
      "content": "export { default as Marquee } from './Marquee.vue'",
      "type": "registry:ui"
    }
  ]
}