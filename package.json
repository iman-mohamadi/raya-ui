    "@tailwindcss/vite": "^4.3.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
