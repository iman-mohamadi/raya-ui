{
  "name": "raya-ui-docs",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build:registry": "tsx scripts/build-registry.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "typecheck:tests": "vue-tsc --noEmit -p tests/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:perf": "E2E_HARNESS=1 nuxt build && PERF=1 playwright test --project=desktop",
    "typecheck:e2e": "vue-tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
